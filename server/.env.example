# Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=rootaroo_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Public origin this server is reachable at — used to build the absolute
# Outlook ICS subscription feed URL (handed to Microsoft's servers, so it
# can't be a relative path). In production this is the Railway domain.
SERVER_BASE_URL=http://localhost:3000

# Twilio (phone OTP delivery — login/signup with phone number). Get
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN from the Twilio Console homepage,
# and TWILIO_PHONE_NUMBER from a purchased/verified number under
# Phone Numbers -> Manage -> Active Numbers. Leave blank to use the
# dev-mode console-logged code instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push notifications go through Expo's own push service (expo-server-sdk) —
# no server-side credential needed; the mobile app just needs an EAS project
# id (app.json's extra.eas.projectId, via `eas init`).

# AWS S3 (or MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rootaroo-dev
S3_REGION=us-east-1
S3_USE_SSL=false

# CloudFront CDN in front of the S3 bucket (production). Leave all three
# blank locally — media links then fall back to plain S3 presigned URLs.
# Domain: the distribution's *.cloudfront.net name. Key pair ID: the public
# key's ID from CloudFront > Key management > Public keys. Private key: the
# matching RSA PEM, with newlines escaped as \n on one line.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Resend (transactional email — verification codes, password resets, admin
# alerts). Get RESEND_API_KEY from the Resend dashboard -> API Keys. The
# EMAIL_FROM domain must be a verified sending domain in that same
# dashboard. Leave RESEND_API_KEY blank to use the dev-mode console-logged
# code instead.
RESEND_API_KEY=
EMAIL_FROM=noreply@rootaroo.com

# Sentry
SENTRY_DSN=

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug

# Rootaroo admin (household leave/delete request review)
ADMIN_EMAIL=
ADMIN_API_KEY=

# ── Billing (Stripe) ──
# dev | staging | prod. Production must be prod.
BILLING_ENV_TAG=
# Test sandbox key for this environment (sk_test_… or rk_test_…). Empty disables test mode.
STRIPE_TEST_SECRET_KEY=
# Comma-separated whsec_… list; two values during a rotation.
STRIPE_TEST_WEBHOOK_SECRETS=
# Production only. Setting these outside production refuses startup.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRETS=
# Optional bootstrap-only keys (products, prices, portal, webhook endpoints). Fall back to the runtime keys.
STRIPE_BOOTSTRAP_TEST_KEY=
STRIPE_BOOTSTRAP_LIVE_KEY=
# https origin used to build Checkout/portal return URLs (defaults to SERVER_BASE_URL outside production)
BILLING_PUBLIC_BASE_URL=
# Staff billing API key (>= 32 chars, must differ from ADMIN_API_KEY) and optional CIDR allowlist
ADMIN_BILLING_API_KEY=
ADMIN_BILLING_IP_ALLOWLIST=
BILLING_GRACE_DAYS=
# Show the required Terms of Service checkbox in Checkout (default true; refused as false in production).
# Requires a Terms of Service URL in the Stripe dashboard (Settings > Public details); set false only in a dev sandbox without one.
BILLING_REQUIRE_TOS_CONSENT=
# rootaroo_app_checkout_<8 lowercase letters>; leave empty to use the built-in constant
STRIPE_INTEGRATION_ID=

# ── Apple App Store (Phase 2) ──
# All optional: with none set, the Apple webhook and verify endpoint answer 503 and IAP stays off. Set the first three together.
# App Store Connect > Users and Access > Integrations > In-App Purchase: the key ID, issuer ID and the .p8 contents (PEM, newlines may be written as backslash-n).
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Defaults to com.rootaroo.app
APPLE_BUNDLE_ID=
# Numeric Apple ID of the app (App Store Connect > App Information). Required in production to verify Production notifications.
APPLE_APP_APPLE_ID=
# ── Google Play (Phase 3) ──
# All optional: set the service account, audience and push email together. Unset = Google endpoints answer 503.
# Play Console API access service account key, as one line of JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Defaults to com.rootaroo.app
GOOGLE_PLAY_PACKAGE_NAME=
# The exact push endpoint URL configured on the Pub/Sub subscription (the OIDC token audience), e.g. https://<api>/api/v1/billing/webhooks/google
GOOGLE_PLAY_RTDN_AUDIENCE=
# The service account the Pub/Sub push subscription authenticates as
GOOGLE_PLAY_RTDN_SA_EMAIL=
