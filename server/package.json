{
  "name": "rootaroo-server",
  "version": "1.0.0",
  "description": "Rootaroo — Family-first mobile application backend",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx sequelize-cli db:migrate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "npx sequelize-cli db:migrate && node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "billing:bootstrap": "tsx src/modules/billing/scripts/stripe-bootstrap.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:int": "jest -c jest.int.config.js --runInBand",
    "test:coverage": "jest --coverage",
    "test:billing-coverage": "node --max-old-space-size=8192 ./node_modules/jest/bin/jest.js -c jest.coverage.config.js --runInBand --coverage",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "format": "prettier --write src/",
    "prepare": "cd .. && husky server/.husky"
  },
  "author": "Sohan Luitel / Dhiraj Yadav / Siddhant Bhatta / Nischal",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bcrypt": "^5.1.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "dotenv": "^16.4.0",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.0",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "node-ical": "^0.27.2",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.27.0",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.0",
    "stripe": "^23.0.0",
    "swagger-jsdoc": "^6.2.0",
    "swagger-ui-express": "^5.0.0",
    "tsdav": "^2.3.3",
    "twilio": "^6.1.0",
    "uuid": "^9.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/jsrsasign": "^10.5.15",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jsrsasign": "^11.1.5",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
