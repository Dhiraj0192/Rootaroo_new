{
  "expo": {
    "name": "Rootaroo",
    "slug": "rootaroo",
    "scheme": "rootaroo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B1220"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#06090F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rootaroo.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rootaroo.app",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rootaroo uses your camera to take photos for posts, journal entries, and vault documents."
        }
      ],
      "expo-notifications",
      "expo-file-system",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rootaroo uses your location when you check in or answer a household ping. It is never tracked in the background."
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Rootaroo uses your camera to scan household invite QR codes, take photos for posts and journal entries, and scan documents into your vault."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Rootaroo to record voice messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "excludes": [
                "**/libc++_shared.so"
              ]
            },
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-iap",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.247745926282-52752edgjmo5h2ao9fut4b0ddjr92hdr"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cce7ed17-3488-4688-aa14-ff7eedef8559"
      }
    },
    "owner": "rootaroos-team"
  }
}
